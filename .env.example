# Copy to .env and fill in. All values below are dummy placeholders, not secrets.
DATABASE_URL=postgres://watchmesh:watchmesh@localhost:5432/watchmesh?sslmode=disable # app DB (compose, serve/sync)
TEST_DATABASE_URL=postgres://watchmesh:watchmesh@localhost:5432/watchmesh?sslmode=disable # isolated DB for make itest (suite drops tables)
WATCHMESH_CONFIG=./config.json # config file path (overrides XDG search)
WATCHMESH_INTERVAL=15m # poll interval override (overrides config file)
TRAKT_ID=example-trakt-id # referenced as env:TRAKT_ID in config.json
TRAKT_SECRET=example-trakt-secret # referenced as env:TRAKT_SECRET in config.json
TRAKT2_ID=example-trakt2-id # second Trakt account (trakt_alt)
TRAKT2_SECRET=example-trakt2-secret # second Trakt account (trakt_alt)
SIMKL_ID=example-simkl-id # referenced as env:SIMKL_ID in config.json
RYOT_URL=http://localhost:8000 # self-hosted Ryot base URL
RYOT_TOKEN=example-ryot-token # referenced as env:RYOT_TOKEN in config.json
YAM_URL=http://localhost:8001 # self-hosted Yamtrack base URL
YAM_TOKEN=example-yam-token # referenced as env:YAM_TOKEN in config.json
